@page
@model ITHMS.Pages.Tickets.UserTicketDetailsModel

@{
    ViewData["Title"] = "Ticket Details";
}

<h2 class="mb-4">Ticket Details</h2>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">Ticket #@Model.Ticket!.TicketId</h5>
    </div>

    <div class="card-body">
        <h4>@Model.Ticket.Title</h4>

        <p class="text-muted">@Model.Ticket.Description</p>

        <hr />

        <p><strong>Category:</strong> @Model.Ticket.Category</p>
        <p><strong>Priority:</strong> @Model.Ticket.Priority</p>
        <p><strong>Status:</strong> @Model.Ticket.Status</p>
        <p><strong>Created At:</strong> @Model.Ticket.CreatedAt</p>
        <p><strong>Created By User ID:</strong> @Model.Ticket.UserId</p>
        <p>
            <strong>Assigned Technician ID:</strong>
            @(Model.Ticket.AssignedTechnicianId?.ToString() ?? "Not Assigned")
        </p>
    </div>

    <div class="card-footer">
        <a asp-page="./Index" asp-route-userId="@Model.Ticket.UserId" class="btn btn-secondary">Back to My Tickets</a>
    </div>
</div>
