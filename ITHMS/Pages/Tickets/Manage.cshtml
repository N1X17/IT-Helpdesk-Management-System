@page
@model ITHMS.Pages.Tickets.Manage
@{
    ViewData["Title"] = "Manage Tickets";
}

<div class="container mt-4">
    <h2 class="mb-4">Manage Support Tickets</h2>

    @if (!string.IsNullOrEmpty(Model.FeedbackMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.FeedbackMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Filtering Form -->
    <form method="get" class="row g-3 mb-4 p-3 bg-light border rounded shadow-sm">
        <div class="col-md-4">
            <label asp-for="SearchTerm" class="form-label">Search</label>
            <input asp-for="SearchTerm" class="form-control" placeholder="Search by title or description..." />
        </div>
        <div class="col-md-3">
            <label asp-for="FilterStatus" class="form-label">Status</label>
            <select asp-for="FilterStatus" asp-items="Html.GetEnumSelectList<ITHMS.Models.Enums.TicketStatus>()" class="form-select">
                <option value="">All Statuses</option>
            </select>
        </div>
        <div class="col-md-3">
            <label asp-for="FilterPriority" class="form-label">Priority</label>
            <select asp-for="FilterPriority" asp-items="Html.GetEnumSelectList<ITHMS.Models.Enums.TicketPriority>()" class="form-select">
                <option value="">All Priorities</option>
            </select>
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </form>

    <!-- Tickets Management Table -->
    <div class="table-responsive shadow-sm">
        <table class="table table-striped table-hover align-middle bg-white border">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Title</th>
                    <th>Technician ID</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Tickets.Any())
                {
                    @foreach (var ticket in Model.Tickets)
                    {
                        <tr>
                            <td>@ticket.TicketId</td>
                            <td><strong>@ticket.Title</strong></td>
                            <form method="post" asp-page-handler="Update">
                                <input type="hidden" name="id" value="@ticket.TicketId" />
                                <td>
                                    <input type="number" name="assignedTechnicianId" value="@ticket.AssignedTechnicianId" class="form-control form-control-sm" placeholder="Tech ID" />
                                </td>
                                <td>
                                    <select name="status" asp-for="@ticket.Status" asp-items="Html.GetEnumSelectList<ITHMS.Models.Enums.TicketStatus>()" class="form-select form-select-sm"></select>
                                </td>
                                <td>
                                    <select name="priority" asp-for="@ticket.Priority" asp-items="Html.GetEnumSelectList<ITHMS.Models.Enums.TicketPriority>()" class="form-select form-select-sm"></select>
                                </td>
                                <td>
                                    <button type="submit" class="btn btn-sm btn-success">Save</button>
                                    <a asp-page="./Details" asp-route-id="@ticket.TicketId" class="btn btn-sm btn-outline-primary">Details</a>
                                </td>
                            </form>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No tickets found matching your criteria.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
