@page
@model ITHMS.Pages.Tickets.CreateModel
@using ITHMS.Models
@{
    ViewData["Title"] = "Create Ticket";
}

<div class="container mt-4">
    <h2>Create a Ticket</h2>
    <p class="text-muted">Submit a new IT request.</p>
    <div class="card shadow-sm mt-4">
        <div class="card-body">
            @if(Model.Message != null)
            {
                <div class="alert alertinfo">
                    @Model.Message
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Employee</label>
                    <select name="userId" class="form-select">
                        @foreach (User user in Model.users)
                            {
                                if (user.Role == Models.Enums.UserRole.Employee)
                                {
                                <option value="@user.UserId"> @user.FullName</option>
                                }
                            }
                        </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Ticket Title</label>
                    <input type="text" name="title" class="form-control" placeholder="Enter ticket title" />
                </div>

                <div class="mb-3">
                    <label class="fprm-label">Description</label>
                    <input type="text" name="description" class="form-control" placeholder="Enter issue description" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Priority</label>
                    <select name="priority" class="form-control">
                        <option value="low">Low</option>
                        <option value="medium">Medium</option>
                        <option value="high">High</option>
                        <option value="critical">Critical</option>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label for="category" class="form-label">Category</label>
                    <select id="category"
                            name="category"
                            class="form-select"
                            required>
                        <option value="">Select Category</option>
                        <option value="Hardware">Hardware</option>
                        <option value="Software">Software</option>
                        <option value="Network">Network</option>
                        <option value="Account">Account</option>
                    </select>
                </div>
                
                <div class="mb-3">
                    <label for="affectedUsers" class="form-label">Number of Affected Users</label>
                    <input type="number"
                           id="affectedUsers"
                           name="affectedUsers"
                           class="form-control"
                           min="1"
                           max="1000"
                           value="1"
                           required />

                    <small class="text-muted">Enter a number between 1 and 1000.</small>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Submit Ticket</button>
                </div>

            </form>
        </div>
    </div>
</div>