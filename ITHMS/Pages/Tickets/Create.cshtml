@page
@model ITHMS.Pages.Tickets.CreateModel
@using ITHMS.Models
@{
    ViewData["Title"] = "Create Ticket";
}

<div class="container mt-4">
    <h2>Create a Ticket</h2>
    <p class="text-muted">Submit a new IT request.</p>
    <div class="card shadow-sm mt-4">
        <div class="card-body">
            @if(Model.Message != null)
            {
                <div class="alert alertinfo">
                    @Model.Message
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Employee</label>
                    <select name="userId" class="form-select">
                        @foreach (User user in Model.users)
                            {
                                if (user.Role == Models.Enums.UserRole.Employee)
                                {
                                <option value="@user.UserId"> @user.FullName</option>
                                }
                            }
                        </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Ticket Title</label>
                    <input type="text" name="title" class="form-control" placeholder="Enter ticket title" />
                </div>

                <div class="mb-3">
                    <label class="fprm-label">Description</label>
                    <input type="text" name="description" class="form-control" placeholder="Enter issue description" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Priority</label>
                    <select name="priority" class="form-control">
                        <option value="low">Low</option>
                        <option value="meduim">Meduim</option>
                        <option value="high">High</option>
                        <option value="critical">Critical</option>
                    </select>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">Submit Ticket</button>
                </div>

            </form>
        </div>
    </div>
</div>